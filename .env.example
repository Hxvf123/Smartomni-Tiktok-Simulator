# Copy to .env and replace every CHANGE_ME. .env is git-ignored; never commit it.
# These credentials are for the SIMULATOR only - do not reuse SmartOmni credentials.

# PostgreSQL (internal Docker network only). Use URL-safe characters (letters, digits, - _ .).
POSTGRES_USER=simulator
POSTGRES_PASSWORD=CHANGE_ME_db_password

# Shared secret for /test-admin/* (seed, reset, clock, faults, replay). Min 8 chars.
TEST_ADMIN_TOKEN=CHANGE_ME_test_admin_token

# Published ports bind to localhost by default. Setting 0.0.0.0 exposes the UI (which proxies the
# admin token) and the API to your network - only do this on a trusted network.
BIND_ADDRESS=127.0.0.1

# URL under which browsers / SmartOmni on the host reach the API.
PUBLIC_API_BASE_URL=http://localhost:8090
# Host base URL as seen FROM inside the containers (callbacks/webhooks to SmartOmni running on the host).
HOST_CALLBACK_BASE_URL=http://host.docker.internal

# Fake simulated app (the SmartOmni "TikTok app"). Not real TikTok credentials.
SEED_APP_KEY=smartomni-dev-app-key
SEED_APP_SECRET=CHANGE_ME_fake_app_secret
SEED_APP_REDIRECT_URIS=http://localhost:8080/api/v1/integrations/tiktok/callback
# Simulator-defined PLACEHOLDER scopes (comma separated); not TikTok scope names.
SEED_APP_SCOPES=sim.authorized_shops.read,sim.product.read,sim.order.read,sim.event.manage,sim.fulfillment.read,sim.fulfillment.write

# Authorization lifetimes (ms) and API signature timestamp window (ms). Simulator choices; TikTok's values are unverified.
# OAUTH_AUTH_CODE_TTL_MS=300000
# OAUTH_ACCESS_TOKEN_TTL_MS=3600000
# OAUTH_REFRESH_TOKEN_TTL_MS=2592000000
# OAUTH_SIGNATURE_WINDOW_MS=300000

SEED_ON_START=true
WEBHOOK_WORKER_ENABLED=true
