{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/demo/:path*", "destination": "https://smartomni-tiktok-simulator-api.onrender.com/demo/:path*" },
    { "source": "/health/:path*", "destination": "https://smartomni-tiktok-simulator-api.onrender.com/health/:path*" },
    { "source": "/test-admin/:path*", "destination": "/api/test-admin?__path=:path*" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ]
}
