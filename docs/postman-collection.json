  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Signs per contracts/signing/README.md: secret + path + sorted(name+value excluding sign/access_token) + raw body + secret, HMAC-SHA256 hex.",
          "// Algorithm evidence: indirect (TTS Open Toolkit local-broker signer); the Common Parameters page was not readable. multipart uploads are NOT signable (rule unverified).",
          "const secret = pm.variables.get('app_secret');",
          "if (!secret) { throw new Error('app_secret variable is empty'); }",
          "const ts = String(Math.floor(Date.now() / 1000));",
          "pm.variables.set('timestamp', ts);",
          "const url = pm.request.url;",
          "const q = {};",
          "url.query.each(p => {",
          "  if (!p.key || p.disabled || p.key === 'sign' || p.key === 'access_token') return;",
          "  q[p.key] = pm.variables.replaceIn(p.value || '');",
          "});",
          "const path = '/' + url.path.map(s => pm.variables.replaceIn(s)).join('/');",
          "let body = '';",
          "if (pm.request.body && pm.request.body.mode === 'raw') { body = pm.variables.replaceIn(pm.request.body.raw || ''); }",
          "if (pm.request.body && pm.request.body.mode === 'formdata') { throw new Error('multipart signing is unverified; do not use this collection for uploads'); }",
          "let s = secret + path;",
          "Object.keys(q).sort().forEach(k => { s += k + q[k]; });",
          "s += body + secret;",
          "pm.variables.set('sign', CryptoJS.HmacSHA256(s, secret).toString(CryptoJS.enc.Hex));"
        ]
      }
    }
  ],
