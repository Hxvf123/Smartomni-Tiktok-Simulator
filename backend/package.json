{
  "name": "smartomni-tiktok-simulator-backend",
  "version": "0.1.0",
  "private": true,
  "description": "TikTok Shop simulator API (NestJS + Prisma + PostgreSQL) for local SmartOmni testing",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "jest --config jest.config.js --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "seed": "node dist/seed-cli.js",
    "openapi:export": "node dist/openapi-export.js"
  },
  "dependencies": {
    "@nestjs/common": "10.4.22",
    "@nestjs/core": "10.4.22",
    "@nestjs/platform-express": "10.4.22",
    "@nestjs/swagger": "7.4.2",
    "@prisma/client": "5.22.0",
    "express": "4.21.2",
    "prisma": "5.22.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/testing": "10.4.22",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.14",
    "@types/node": "22.10.2",
    "@types/supertest": "6.0.2",
    "embedded-postgres": "16.14.0-beta.17",
    "eslint": "9.39.5",
    "jest": "29.7.0",
    "supertest": "7.0.0",
    "ts-jest": "29.4.14",
    "typescript": "5.6.3",
    "typescript-eslint": "8.71.2"
  }
}
