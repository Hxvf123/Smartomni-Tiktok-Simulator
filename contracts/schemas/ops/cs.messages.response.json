{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ops/cs.messages.response.json",
  "title": "GET /customer_service/202309/conversations/{conversation_id}/messages response",
  "x-verification": "official OAS 0.1.7 (2026-10-14); OAS declares no per-field required flags, so only the envelope trio code/message/request_id is required here (envelope trio taken from every OAS response schema)",
  "type": "object",
  "properties": {
    "code": {
      "type": "integer"
    },
    "data": {
      "type": "object",
      "properties": {
        "messages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "content": {
                "type": "string"
              },
              "create_time": {
                "type": "integer"
              },
              "data": {
                "type": "string"
              },
              "id": {
                "type": "string"
              },
              "index": {
                "type": "string"
              },
              "is_visible": {
                "type": "boolean"
              },
              "sender": {
                "type": "object",
                "properties": {
                  "avatar": {
                    "type": "string"
                  },
                  "im_user_id": {
                    "type": "string"
                  },
                  "nickname": {
                    "type": "string"
                  },
                  "role": {
                    "type": "string"
                  }
                }
              },
              "type": {
                "type": "string"
              }
            }
          }
        },
        "next_page_token": {
          "type": "string"
        },
        "unsupported_msg_tips": {
          "type": "string"
        }
      }
    },
    "message": {
      "type": "string"
    },
    "request_id": {
      "type": "string"
    }
  },
  "required": [
    "code",
    "message",
    "request_id"
  ]
}
